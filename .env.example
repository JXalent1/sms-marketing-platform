# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.
# Every client-specific value in the entire app lives in this file.
#
# THE DEFAULTS BELOW ARE FOR A DEVELOPER'S MACHINE, not for a server.
# `cp .env.example .env` then `npm run build:css && alembic upgrade head` and
# the app runs. That is the point of them.
#
# This file used to ship ENVIRONMENT=production, and the app deliberately does
# not migrate on startup in production (two workers restarting together would
# race — see app/main.py::_ensure_schema). So a fresh clone came up against a
# database with no tables and answered 500 on every page, with the real cause
# one line in the log. A first impression that costs an hour.
#
# For a real deployment, do NOT copy this file and edit it from memory. Work
# through deployment/PRODUCTION_CHECKLIST.md, which lists every variable that
# has to change, what it does, and what breaks when it is wrong.
# ─────────────────────────────────────────────────────────────────────────────

# ── Brand ────────────────────────────────────────────────────────────────────
BRAND_NAME=Example Company
BRAND_SHORT_NAME=Example
BRAND_APP_NAME=Example Marketing
BRAND_SUPPORT_PHONE=(555) 123-4567
BRAND_SUPPORT_EMAIL=info@example.com
# Brand palette as literal hex (#RRGGBB), not a Tailwind color name. Leave blank
# to use the validated defaults from the design file. These two feed --brand and
# --accent; the category colors --s1..--s4 are deliberately not configurable.
BRAND_COLOR_HEX=
BRAND_ACCENT_HEX=

# ── Admin login ──────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# Generate with: python scripts/hash_password.py
ADMIN_PASSWORD_HASH=
# Dev-only shortcut; leave blank in production and use the hash above.
ADMIN_PASSWORD=

# Signs the session cookie. Generate with: openssl rand -hex 32
SECRET_KEY=
SESSION_COOKIE_NAME=session
SESSION_DAYS=7
COOKIE_SECURE=true              # set false only for local http:// development

# ── SMS provider ─────────────────────────────────────────────────────────────
# console = dry run (logs, never sends). Keep this until you are ready to go live.
SMS_PROVIDER=console

TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=+1XXXXXXXXXX
TELNYX_MESSAGING_PROFILE_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── Sending behaviour ────────────────────────────────────────────────────────
SEND_DELAY_SECONDS=0.15
SKIP_NON_US_NUMBERS=true        # false if the messaging profile covers Canada/intl
PREFLIGHT_BALANCE_CHECK=true    # refuse to start a campaign the balance can't fund
# OUR wholesale rate, for the capacity estimate only. Never shown to the client;
# what he pays is BILLING_PRICE_PER_SEGMENT below. (Was PREFLIGHT_COST_PER_SEGMENT.)
WHOLESALE_COST_PER_SEGMENT=0.009

# ── Pricing plan (what you bill the client) ──────────────────────────────────
# The plan is: monthly fee + (segments beyond the included allowance x rate).
# These three values are the only place the commercial terms exist. Nothing is
# hardcoded in a template, a service or a test fixture.
#
# The values below are Auctions4America's agreed terms: no monthly fee, 10,000
# segments included per cycle, $0.015 per segment after that.
BILLING_ENABLED=true
BILLING_CYCLE_DAY=1
BILLING_MONTHLY_FEE=0
BILLING_SEGMENTS_INCLUDED=10000
BILLING_PRICE_PER_SEGMENT=0.015

# ── Alerts ───────────────────────────────────────────────────────────────────
ALERT_PHONE=+1XXXXXXXXXX        # YOUR number, not the client's
BALANCE_ALERT_THRESHOLD=50

# ── Infrastructure ───────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/app.db

# Webhook URLs are built from this. On a dev machine nothing calls back, so the
# value only has to be syntactically valid. In production a wrong value means no
# delivery receipts and — the part that matters — no inbound STOP.
PUBLIC_BASE_URL=http://localhost:8000

DEBUG=false

# development: the app runs `alembic upgrade head` itself at startup, so a fresh
#              clone just works.
# production:  it does not, because two workers restarting together would race
#              into the same migration. deployment/deploy.sh runs it explicitly
#              before the restart instead.
# Set this to production on the server, and only there.
ENVIRONMENT=development
