# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.
# Every client-specific value in the entire app lives in this file.
#
# THE DEFAULTS BELOW ARE FOR A DEVELOPER'S MACHINE, not for a server.
# `cp .env.example .env` then `npm run build:css && alembic upgrade head` and
# the app runs. That is the point of them.
#
# This file used to ship ENVIRONMENT=production, and the app deliberately does
# not migrate on startup in production (two workers restarting together would
# race — see app/main.py::_ensure_schema). So a fresh clone came up against a
# database with no tables and answered 500 on every page, with the real cause
# one line in the log. A first impression that costs an hour.
#
# For a real deployment, do NOT copy this file and edit it from memory. Work
# through deployment/PRODUCTION_CHECKLIST.md, which lists every variable that
# has to change, what it does, and what breaks when it is wrong.
# ─────────────────────────────────────────────────────────────────────────────

# ── Brand ────────────────────────────────────────────────────────────────────
BRAND_NAME=Example Company
BRAND_SHORT_NAME=Example
BRAND_APP_NAME=Example Marketing
BRAND_SUPPORT_PHONE=(555) 123-4567
BRAND_SUPPORT_EMAIL=info@example.com
# Brand palette as literal hex (#RRGGBB), not a Tailwind color name. Leave blank
# to use the validated defaults from the design file. These two feed --brand and
# --accent; the category colors --s1..--s4 are deliberately not configurable.
BRAND_COLOR_HEX=
BRAND_ACCENT_HEX=

# ── Admin login ──────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# Generate with: python scripts/hash_password.py
ADMIN_PASSWORD_HASH=
# Dev-only shortcut; leave blank in production and use the hash above.
ADMIN_PASSWORD=

# Signs the session cookie. Generate with: openssl rand -hex 32
SECRET_KEY=
SESSION_COOKIE_NAME=session
SESSION_DAYS=7
COOKIE_SECURE=true              # set false only for local http:// development

# ── SMS provider ─────────────────────────────────────────────────────────────
# console = dry run (logs, never sends). Keep this until you are ready to go live.
SMS_PROVIDER=console

TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=+1XXXXXXXXXX
TELNYX_MESSAGING_PROFILE_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── Sending behaviour ────────────────────────────────────────────────────────
SEND_DELAY_SECONDS=0.15
SKIP_NON_US_NUMBERS=true        # false if the messaging profile covers Canada/intl
PREFLIGHT_BALANCE_CHECK=true    # refuse to start a campaign the balance can't fund
# OUR wholesale rate, for the capacity estimate only. Never shown to the client;
# what he pays is BILLING_PRICE_PER_SEGMENT below. (Was PREFLIGHT_COST_PER_SEGMENT.)
WHOLESALE_COST_PER_SEGMENT=0.009

# ── Pricing plan (what you bill the client) ──────────────────────────────────
# The plan is: monthly fee + (segments beyond the included allowance x rate).
# These three values are the only place the commercial terms exist. Nothing is
# hardcoded in a template, a service or a test fixture.
#
# The values below are Auctions4America's agreed terms: no monthly fee, 10,000
# segments included per cycle, $0.015 per segment after that.
BILLING_ENABLED=true
BILLING_CYCLE_DAY=1
BILLING_MONTHLY_FEE=0
BILLING_SEGMENTS_INCLUDED=10000
BILLING_PRICE_PER_SEGMENT=0.015

# ── Alerts ───────────────────────────────────────────────────────────────────
ALERT_PHONE=+1XXXXXXXXXX        # YOUR number, not the client's
BALANCE_ALERT_THRESHOLD=50

# ── Infrastructure ───────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/app.db

# Webhook URLs are built from this. On a dev machine nothing calls back, so the
# value only has to be syntactically valid. In production a wrong value means no
# delivery receipts and — the part that matters — no inbound STOP.
PUBLIC_BASE_URL=http://localhost:8000

# ── Short links ──────────────────────────────────────────────────────────────
# The dedicated short domain, e.g. bida4a.com. Every character is charged for
# at 4,000 recipients, which is why it is a domain of its own rather than a
# subdomain of the site above.
#
# Blank is supported and is not a broken state: the composer refuses the {link}
# merge tag with a message naming the cause rather than minting links nobody can
# follow. Leave it blank until the domain is registered and pointed here.
#
# Setting it does a second thing that is easy to miss: it switches on the
# host guard in app/main.py, so once this matches the Host nginx forwards, that
# domain serves ONLY the redirect route and every admin path answers 404. Both
# server blocks in deployment/nginx.conf.template are needed for that to work.
SHORT_LINK_DOMAIN=

# Whether the rendered link carries "https://". Off by default because handsets
# linkify a bare domain and the scheme is eight characters on every message.
SHORT_LINK_INCLUDE_SCHEME=false

# A click arriving sooner than this after the carrier accepted the message is
# counted as a scanner rather than a person. 0 turns the timing rule off; the
# user-agent rule still runs.
CLICK_MIN_HUMAN_SECONDS=8

# ─── Prospecting (session P1) ────────────────────────────────────────────────
# Which line-type provider screens scraped numbers before they can be promoted
# into contacts. "none" is the default and makes NO network call at all: every
# prospect then reads as unscreened, and an unscreened number cannot be
# promoted. That is the gate working, not a bug — a screening step that is
# switched off refuses rather than waving landlines onto the list.
#
# A carrier lookup costs money per call, so switching this on is a budget
# decision and a deliberate one. Session P1b shipped the carrier provider —
# set this to "telnyx" and it uses TELNYX_API_KEY above — but the default did
# not move: turning screening on starts spending, and that is a human's edit on
# a live box rather than a consequence of deploying.
PROSPECT_LOOKUP_PROVIDER=none

# What ONE lookup costs us, for the job cost record. OUR spend, not the
# client's — same rule as WHOLESALE_COST_PER_SEGMENT. It must never reach a
# response body, a template or an export.
PROSPECT_LOOKUP_COST_PER_NUMBER=0.0025

# The most screening may spend in a calendar month, in dollars. Checked BEFORE
# every call, so the balance is never drained past it.
#
# This matters more than it looks: **lookups and sends draw on the same carrier
# balance**. A 10,000-number screening run takes $25 out of the pot the campaign
# pre-flight check measures, so an overnight scrape can make the next morning's
# campaign refuse to start with nothing on any screen connecting the two. The
# default is deliberately low — the cheap error is a queue that stops filling.
#
# 0 switches screening off entirely rather than meaning "unlimited".
PROSPECT_LOOKUP_MONTHLY_CAP=50.0

# "Can they collect it." Miles per category slug; null means national, and a
# category not listed here falls back to PROSPECT_DEFAULT_RADIUS_MILES. JSON.
PROSPECT_CATEGORY_RADIUS_MILES={"food_service":150,"equipment":150,"general":150,"estates":100,"memorabilia":null}
PROSPECT_DEFAULT_RADIUS_MILES=150

# A discovery run that has not finished in this long is abandoned, its cleanup
# is run and it is recorded as timed out. Seconds.
PROSPECT_JOB_TIMEOUT_SECONDS=300

# When a search term's rejections are mostly sellers or competitors, the term is
# finding the wrong side of the room and is flagged for removal. The minimum
# counts rejections — the denominator of the share — because a share is
# meaningless on a sample of one.
PROSPECT_TERM_FLAG_MIN_REJECTIONS=5
PROSPECT_TERM_FLAG_SHARE=0.5

DEBUG=false

# development: the app runs `alembic upgrade head` itself at startup, so a fresh
#              clone just works.
# production:  it does not, because two workers restarting together would race
#              into the same migration. deployment/deploy.sh runs it explicitly
#              before the restart instead.
# Set this to production on the server, and only there.
ENVIRONMENT=development
