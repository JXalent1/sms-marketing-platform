# systemd unit.
#   sudo cp deployment/app.service.template /etc/systemd/system/APP_NAME.service
#   edit the paths and User below
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now APP_NAME
#   sudo journalctl -u APP_NAME -f

[Unit]
Description=SMS Marketing Platform
After=network.target

[Service]
Type=simple

# Run as a dedicated unprivileged user, never root. If the app is ever
# compromised, this is the difference between a bad day and a lost box.
User=appuser
Group=appuser

WorkingDirectory=/home/appuser/app
Environment="PATH=/home/appuser/app/venv/bin"
ExecStart=/home/appuser/app/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000

Restart=always
RestartSec=10

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/appuser/app/data /home/appuser/app/logs /home/appuser/app/exports

# The LiveAuctioneers scraper keeps a logged-in Chromium profile. ProtectHome
# above is read-only and ReadWritePaths covers only the app tree, so the profile
# cannot live under /home/appuser — the browser-profile guard refuses it and
# every daily run fails. StateDirectory gives systemd's own writable location
# (/var/lib/sms-platform-browser, created 0700 and owned by User=), which is also
# the right place for it: it is a live session for the client's auction account
# and must not sit inside a tree that deploy.sh rsyncs or backup.sh archives.
# Pair with BROWSER_PROFILE_ROOT=/var/lib/sms-platform-browser in .env.
StateDirectory=sms-platform-browser

[Install]
WantedBy=multi-user.target
