# nginx reverse proxy.
#   sudo cp deployment/nginx.conf.template /etc/nginx/sites-available/APP_NAME
#   sudo sed -i 's/YOUR_DOMAIN/actual.domain.com/g' /etc/nginx/sites-available/APP_NAME
#   sudo ln -s /etc/nginx/sites-available/APP_NAME /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d actual.domain.com
#
# Updating an already-certificated box: certbot has rewritten the server block
# below to listen on 443 and added its own :80 redirect block. Do not re-copy
# this file over it — merge the two header sections into the existing 443 block
# by hand, then `sudo nginx -t && sudo systemctl reload nginx`. Confirm with:
#   curl -sI https://actual.domain.com/login | grep -i "strict-transport\|content-security\|x-frame\|x-content\|referrer"
#   curl -s -o /dev/null -w "%{http_code}\n" https://actual.domain.com/static/fonts/inter-latin-400-normal.woff2

server {
    listen 80;
    server_name YOUR_DOMAIN;
    # Certbot rewrites this block to redirect to HTTPS when you run it.

    # ─── Security headers ───────────────────────────────────────────────────
    # This is a public admin panel with a session cookie and a client's entire
    # contact list behind it, and it shipped without any of these.
    #
    # `always` on every one of them: without it nginx omits the header on error
    # responses, and a 502 while the app restarts is exactly when a framed or
    # sniffed response is worth something to an attacker.

    # Five minutes, not a year. HSTS is not revocable — a browser that has seen
    # a long max-age refuses plain HTTP to this host until it expires, no matter
    # what the server says afterwards. Start where a mistake costs five minutes,
    # raise it deliberately once renewals have proven themselves, and only add
    # includeSubDomains/preload when nothing else lives on the domain.
    add_header Strict-Transport-Security "max-age=300" always;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;

    # same-origin: a referrer is useful in our own logs and is nobody else's
    # business. The dashboard links nowhere external, so this costs nothing.
    add_header Referrer-Policy "same-origin" always;

    # ─── Content-Security-Policy ────────────────────────────────────────────
    # The app's asset profile is genuinely same-origin-only: Tailwind is compiled
    # to /static/app.css at build time, Inter is self-hosted under /static/fonts,
    # and nothing is fetched from a CDN. That is what makes a policy this tight
    # possible; a template that reintroduces a CDN breaks here, which is the
    # intended outcome.
    #
    # One literal line, not a `set $csp ...` chain. The chain reads better and
    # lets each directive carry its own comment, but a header built from a
    # variable is only emitted once the rewrite phase has run — nginx sends no
    # CSP at all on a request it rejects before that, which is exactly the class
    # of response `always` is here to cover. Keep the reasoning up here instead:
    #
    #   script-src 'unsafe-inline'  Load-bearing, not laziness. base.html applies
    #       the saved theme before first paint, every screen carries its own
    #       <script> block, and two build markup with inline onclick handlers
    #       (blocklist.html's Unblock, the composer's Send). Nonces would mean
    #       emitting one per render AND rewriting those handlers — and a nonce
    #       makes the browser *ignore* 'unsafe-inline', so a half-done migration
    #       silently kills exactly those buttons with nothing in the console the
    #       client would think to report. What this still buys: no third-party
    #       origin can be a script source at all.
    #   style-src 'unsafe-inline'   _brand.html emits an inline <style> for the
    #       client's palette; today.html and usage.html size chart bars with a
    #       style attribute.
    #   font-src 'self'             The one most likely to break something
    #       visible: app.css pulls four woff2 from /static/fonts. If this is
    #       wrong the app silently renders in the system font and nothing errors.
    #   img-src 'self'              No images ship with the app and there is no
    #       <link rel="icon">; 'self' still covers the browser's automatic
    #       /favicon.ico. `data:` was here for "a future inline SVG", which is
    #       not an img-src concern at all — inline <svg> is never fetched. Dead
    #       permission, removed.
    #   connect-src 'self'          Every fetch in the app goes to its own /api.
    #   form-action 'self'          The login form posts here. Anywhere else is
    #       credential theft.
    #   frame-ancestors 'none'      The modern half of X-Frame-Options above.
    #       Both are set because both are still read by browsers in the field.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # The app reads X-Forwarded-For for audit logging and rate limiting.
        # Without it every request appears to come from 127.0.0.1 and the
        # per-IP limiter becomes one global bucket.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Campaign sends run as background tasks, but imports can be slow.
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    client_max_body_size 25M;    # CSV uploads

    # Blocks the noisiest scanner probes. Not security on its own — auth is.
    # No add_header of its own on purpose: a location that sets one stops
    # inheriting every header above, and a 404 with no security headers is the
    # gap this whole section exists to close.
    location ~ /\.(git|env|svn) { deny all; return 404; }
}

# ─── The short-link domain ────────────────────────────────────────────────────
# The domain printed in every text message. It is the same app process as the
# block above — one uvicorn, one nginx — and that is exactly why it needs a
# block of its own:  without one, every route answers on both names and
# YOUR_SHORT_DOMAIN/login is the client's entire contact list on the domain a
# stranger is handed with every campaign.
#
#   sudo sed -i 's/YOUR_SHORT_DOMAIN/bida4a.com/g'          /etc/nginx/sites-available/APP_NAME
#   sudo sed -i 's|YOUR_AUCTION_SITE|https://example.com|g' /etc/nginx/sites-available/APP_NAME
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d bida4a.com
#
# Confirm both directions afterwards — this is the whole point of the block:
#   curl -s -o /dev/null -w "%{http_code}\n" https://bida4a.com/login       # 404
#   curl -sI https://bida4a.com/ | head -1                                  # 302
#   curl -sI https://bida4a.com/<a-real-slug> | head -1                     # 302
#
# **There is no path denylist here, deliberately.** One was considered and
# rejected: it would have to list every admin path, so it is wrong the first
# time a route is added and nobody notices — the failure is silent and on the
# host nobody looks at. The app answers the question instead, in
# `short_link_host_guard` in app/main.py, which asks whether the path *is* a
# short link rather than whether it is one of the things we remembered to
# forbid. So this block proxies everything and lets the middleware decide, and
# the two files cannot drift because only one of them decides anything.
server {
    listen 80;
    server_name YOUR_SHORT_DOMAIN;
    # Certbot rewrites this block to redirect to HTTPS when you run it.

    # No Referrer-Policy here, on purpose. The app sets `no-referrer` on the
    # redirect itself — a slug identifies one buyer and is nobody's analytics —
    # and `add_header` appends rather than replaces, so setting it here too
    # would send the header twice on the one response that matters.
    add_header Strict-Transport-Security "max-age=300" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Nothing on this host renders: it serves 302s and a plain-text 404. So the
    # policy is the empty one rather than the app's, and if that ever stops
    # being true the breakage is loud.
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;

    # Certbot's webroot plugin needs this; the --nginx plugin does not, and a
    # location that exists costs nothing either way. `^~` so it wins over the
    # proxy below without regex evaluation.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Somebody will type the bare domain after reading it off a text message.
    # Send them to the auction house's own site rather than to a 404 — this is
    # the one path here that is a person rather than a link.
    location = / {
        return 302 YOUR_AUCTION_SITE;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        # `$host` is what the middleware compares against SHORT_LINK_DOMAIN. If
        # this is ever changed to a literal or to $proxy_host, the guard stops
        # matching and every admin route quietly answers on this domain again.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # No uploads reach this host — the only route it serves is a GET redirect —
    # so a large body is rejected by nginx instead of being buffered and
    # proxied to a 404.
    client_max_body_size 1k;

    location ~ /\.(git|env|svn) { deny all; return 404; }
}
