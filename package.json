{
  "name": "sms-marketing-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Build-time asset pipeline. Tailwind is compiled to app/static/app.css; nothing is fetched from a CDN at runtime.",
  "scripts": {
    "build:css": "tailwindcss -i ./app/assets/tailwind.css -o ./app/static/app.css --minify",
    "watch:css": "tailwindcss -i ./app/assets/tailwind.css -o ./app/static/app.css --watch",
    "fonts:sync": "cp node_modules/@fontsource/inter/files/inter-latin-400-normal.woff2 node_modules/@fontsource/inter/files/inter-latin-500-normal.woff2 node_modules/@fontsource/inter/files/inter-latin-600-normal.woff2 node_modules/@fontsource/inter/files/inter-latin-700-normal.woff2 app/static/fonts/"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "tailwindcss": "3.4.17"
  }
}
